{
	"name": "@kirick/mysql",
	"version": "0.2.0-dev",
	"description": "MySQL / MariaDB client with template string support.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"files": [
		"dist/"
	],
	"exports": {
		".": {
			"types": {
				"import": "./dist/main.d.mts",
				"require": "./dist/main.d.cts"
			},
			"import": "./dist/main.mjs",
			"require": "./dist/main.cjs"
		}
	},
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"bun-types": "1.4.4",
		"mysql2": "3.14.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@kirick/lint": "0.4.2",
		"@types/node": "^22",
		"eslint": "10.7.0",
		"oxlint": "1.74.0",
		"publint": "0.3.25",
		"tsdown": "0.23.0",
		"typescript": "6.0.3",
		"unplugin-unused": "0.6.0",
		"vitest": "5.0.3"
	},
	"scripts": {
		"build": "tsdown src/main.ts --format esm --format cjs --dts --publint --unused",
		"check": "bun lint && bun run test",
		"test": "bun run build && bun scripts/test-databases.ts",
		"test:vitest": "vitest run --no-file-parallelism",
		"test:shared": "bun --no-env-file test src",
		"test:docker": "bun run test"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kirick-ts/mysql.git"
	},
	"keywords": [
		"mysql",
		"client",
		"sql"
	],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/kirick-ts/mysql/issues"
	},
	"homepage": "https://github.com/kirick-ts/mysql#readme"
}
